# Copy this file to .env and change the values before running in production.

POSTGRES_USER=medislot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medislot
DATABASE_URL=postgresql+psycopg://medislot:change-me@postgres:5432/medislot

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM_ADDRESS=MediSlot <no-reply@medislot.dev>
SMS_PROVIDER=log

ENVIRONMENT=development
